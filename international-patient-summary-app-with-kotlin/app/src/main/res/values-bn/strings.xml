    <string name="about_title">পরিচিতি</string>
    <string name="about_safety_heading">চিকিৎসা যন্ত্র নয়</string>
    <string name="about_safety_body">এই অ্যাপ নথিতে যা লেখা আছে তা-ই দেখায় এবং কখনো এর ক্লিনিকাল বিষয়বস্তু বদলায় না। ক্লিনিকাল সিদ্ধান্ত মূল রেকর্ড পড়া চিকিৎসকের।</string>
    <string name="about_privacy_heading">আপনার তথ্য</string>
    <string name="about_privacy_body">সারসংক্ষেপ কেবল এই ফোনে, এনক্রিপ্ট করে, সংরক্ষণ করা হয় এবং আপনি না মোছা পর্যন্ত থাকে, ফোন রিস্টার্ট হওয়ার পরেও। অ্যাপটি কোথাও কিছু পাঠায় না এবং এর ইন্টারনেট অ্যাক্সেস নেই। আপনি শেয়ার-এ ট্যাপ করলেই কেবল সারসংক্ষেপ ফোনের বাইরে যায়।</string>
