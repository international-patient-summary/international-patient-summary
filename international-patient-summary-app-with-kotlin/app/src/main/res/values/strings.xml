    <!-- About, M-ABOUT-1 and M-PRIV-3 -->
    <string name="about_title">About</string>
    <string name="about_safety_heading">Not a medical device</string>
    <string name="about_safety_body">This app shows what a document says and never changes its clinical content. Clinical decisions belong to the clinician reading the source record.</string>
    <string name="about_privacy_heading">Your data</string>
    <string name="about_privacy_body">Summaries are kept in memory only, and are forgotten when the app ends. The app sends nothing anywhere and has no internet access. A summary leaves the phone only when you tap Share.</string>
