    "list.empty.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "افتح ملخصًا دوليًا للمريض من ملف، أو من الحافظة، أو من الأمثلة. يُحفظ على هذا الجهاز فقط، مشفّرًا، إلى أن تحذفه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отворете International Patient Summary от файл, от клипборда или от примерите. Резюмето се записва само на това устройство, шифровано, докато не го изтриете."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फ़ाइल, क्लिपबोर्ड भा उदाहरण से International Patient Summary खोलीं। ई खाली एह डिवाइस पर, एन्क्रिप्ट क के, सहेजल रहेला, जबले रउआ एकरा के हटाईं ना।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ফাইল, ক্লিপবোর্ড বা উদাহরণ থেকে একটি আন্তর্জাতিক রোগী সারসংক্ষেপ খুলুন। আপনি না মোছা পর্যন্ত এটি কেবল এই ডিভাইসে, এনক্রিপ্ট করে, সংরক্ষিত থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otevřete International Patient Summary ze souboru, ze schránky nebo z ukázek. Uloží se pouze v tomto zařízení, šifrovaně, dokud ho nesmažete."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agorwch Grynodeb Rhyngwladol o Gleifion o ffeil, y clipfwrdd, neu’r enghreifftiau. Caiff ei storio ar y ddyfais hon yn unig, wedi’i amgryptio, nes i chi ei ddileu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Åbn en International Patient Summary fra en fil, udklipsholderen eller eksemplerne. Den gemmes kun på denne enhed, krypteret, indtil du sletter den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffnen Sie eine International Patient Summary aus einer Datei, der Zwischenablage oder den Beispielen. Sie wird verschlüsselt und nur auf diesem Gerät gespeichert, bis Sie sie löschen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ανοίξτε μια International Patient Summary από αρχείο, από το πρόχειρο ή από τα παραδείγματα. Αποθηκεύεται μόνο σε αυτή τη συσκευή, κρυπτογραφημένη, μέχρι να τη διαγράψετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open an International Patient Summary from a file, the clipboard, or the examples. It is saved on this device only, encrypted, until you delete it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open an International Patient Summary from a file, the clipboard, or the examples. It is saved on this device only, encrypted, until you delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre un Resumen Internacional del Paciente desde un archivo, el portapapeles o los ejemplos. Se guarda solo en este dispositivo, cifrado, hasta que lo elimines."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ava International Patient Summary failist, lõikelaualt või näidete hulgast. See salvestatakse ainult sellesse seadmesse, krüpteerituna, kuni selle kustutad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ireki International Patient Summary bat fitxategi batetik, arbeletik edo adibideetatik. Gailu honetan bakarrik gordetzen da, enkriptatuta, ezabatzen duzun arte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "یک International Patient Summary را از فایل، کلیپ‌بورد یا نمونه‌ها باز کنید. تا وقتی آن را حذف نکنید، فقط روی همین دستگاه و به‌صورت رمزگذاری‌شده ذخیره می‌ماند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avaa International Patient Summary tiedostosta, leikepöydältä tai esimerkeistä. Se tallennetaan salattuna vain tälle laitteelle, kunnes poistat sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Magbukas ng International Patient Summary mula sa isang file, sa clipboard, o sa mga halimbawa. Naka-save lang ito sa device na ito, naka-encrypt, hanggang burahin mo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez un Résumé patient international depuis un fichier, le presse-papiers ou les exemples. Il est enregistré uniquement sur cet appareil, chiffré, jusqu’à ce que vous le supprimiez."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oscail International Patient Summary ó chomhad, ón ngearrthaisce nó ó na samplaí. Sábháiltear an achoimre ar an ngléas seo amháin, criptithe, go dtí go scriosann tú í."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fosgail International Patient Summary à faidhle, on stòr-bhòrd no o na h-eisimpleirean. Thèid a shàbhaladh air an uidheam seo a-mhàin, crioptaichte, gus an sguab thu às e."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ફાઇલ, ક્લિપબોર્ડ અથવા ઉદાહરણોમાંથી International Patient Summary ખોલો. તમે તેને કાઢી નાખો ત્યાં સુધી તે ફક્ત આ ઉપકરણ પર, એન્ક્રિપ્ટ કરીને સાચવેલો રહે છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buɗe International Patient Summary daga fayil, allon kwafi, ko misalai. Ana ajiye shi a kan wannan na'ura kawai, cikin ɓoyayyen tsari, har sai kun share shi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אפשר לפתוח International Patient Summary מקובץ, מהלוח או מהדוגמאות. הוא נשמר במכשיר הזה בלבד, מוצפן, עד שמוחקים אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फ़ाइल, क्लिपबोर्ड या उदाहरणों से अंतरराष्ट्रीय रोगी सारांश खोलें। यह केवल इस डिवाइस पर, एन्क्रिप्ट करके सहेजा जाता है, जब तक आप इसे हटा नहीं देते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otvorite International Patient Summary iz datoteke, međuspremnika ili primjera. Sprema se samo na ovaj uređaj, šifriran, dok ga ne izbrišete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nyisson meg egy International Patient Summary dokumentumot fájlból, a vágólapról vagy a példák közül. Csak ezen az eszközön, titkosítva tárolódik, amíg Ön nem törli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Buka Ringkasan Pasien Internasional dari file, papan klip, atau contoh. Ringkasan hanya disimpan di perangkat ini, terenkripsi, sampai Anda menghapusnya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opnaðu alþjóðlegt sjúklingayfirlit úr skrá, af klemmuspjaldinu eða úr dæmunum. Það er aðeins vistað á þessu tæki, dulkóðað, þar til þú eyðir því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apri un International Patient Summary da un file, dagli appunti o dagli esempi. Viene salvato solo su questo dispositivo, crittografato, finché non lo elimini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ファイル、クリップボード、またはサンプルから国際患者サマリーを開いてください。サマリーは削除するまで、このデバイスにのみ暗号化して保存されます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bukak International Patient Summary saka berkas, clipboard, utawa conto. Ringkesan mung disimpen ing piranti iki, dienkripsi, nganti panjenengan busak."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "បើកសង្ខេបអ្នកជំងឺអន្តរជាតិពីឯកសារ ក្ដារតម្បៀតខ្ទាស់ ឬឧទាហរណ៍។ វាត្រូវបានរក្សាទុកតែនៅលើឧបករណ៍នេះប៉ុណ្ណោះ ដោយត្រូវបានអ៊ិនគ្រីប រហូតដល់អ្នកលុបវា។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಫೈಲ್, ಕ್ಲಿಪ್‌ಬೋರ್ಡ್ ಅಥವಾ ಉದಾಹರಣೆಗಳಿಂದ International Patient Summary ತೆರೆಯಿರಿ. ನೀವು ಅಳಿಸುವವರೆಗೆ ಅದನ್ನು ಈ ಸಾಧನದಲ್ಲಿ ಮಾತ್ರ, ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿ ಉಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
