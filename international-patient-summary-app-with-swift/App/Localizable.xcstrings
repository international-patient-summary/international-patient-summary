    "about.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحفظ الملخصات على هذا الجهاز فقط، مشفّرةً، وتبقى إلى أن تحذفها، حتى بعد إعادة تشغيل الجهاز. لا يوجد حساب، ولا يرسل التطبيق أي طلبات عبر الشبكة. لا يغادر الملخص الجهاز إلا عند مشاركته."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Резюметата се записват само на това устройство, шифровани, и се пазят, докато не ги изтриете, дори след рестартиране на устройството. Няма профил и приложението не прави мрежови заявки. Резюме напуска устройството само ако го споделите."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सारांश खाली एह डिवाइस पर, एन्क्रिप्ट क के, सहेजल जाला आ जबले रउआ ओकरा के हटाईं ना, तबले रहेला, डिवाइस रीस्टार्ट भइला के बादो। कवनो खाता नइखे, आ ऐप कवनो नेटवर्क अनुरोध ना करे। सारांश डिवाइस से तबे बाहर जाला जब रउआ ओकरा के शेयर करीं।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সারসংক্ষেপগুলো কেবল এই ডিভাইসে, এনক্রিপ্ট করে, সংরক্ষণ করা হয় এবং আপনি না মোছা পর্যন্ত থাকে, ডিভাইস রিস্টার্ট হওয়ার পরেও। কোনো অ্যাকাউন্ট নেই, আর অ্যাপটি কোনো নেটওয়ার্ক অনুরোধ করে না। আপনি শেয়ার করলেই কেবল সারসংক্ষেপ ডিভাইসের বাইরে যায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Souhrny se ukládají pouze v tomto zařízení, šifrovaně, a uchovávají se, dokud je nesmažete, i po restartu zařízení. Aplikace nemá žádný účet a neodesílá žádné síťové požadavky. Souhrn opustí zařízení, jen pokud ho sdílíte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caiff crynodebau eu storio ar y ddyfais hon yn unig, wedi’u hamgryptio, a’u cadw nes i chi eu dileu, hyd yn oed ar ôl i’r ddyfais ailgychwyn. Does dim cyfrif, ac nid yw’r ap yn gwneud unrhyw geisiadau rhwydwaith. Dim ond pan fyddwch chi’n ei rannu y bydd crynodeb yn gadael y ddyfais."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oversigter gemmes kun på denne enhed, krypteret, og bevares, indtil du sletter dem, også efter at enheden er genstartet. Der er ingen konto, og appen foretager ingen netværksforespørgsler. En oversigt forlader kun enheden, når du deler den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Übersichten werden verschlüsselt und nur auf diesem Gerät gespeichert und bleiben erhalten, bis Sie sie löschen – auch nach einem Neustart des Geräts. Es gibt kein Konto, und die App stellt keine Netzwerkanfragen. Eine Übersicht verlässt das Gerät nur, wenn Sie sie teilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Οι συνόψεις αποθηκεύονται μόνο σε αυτή τη συσκευή, κρυπτογραφημένες, και διατηρούνται μέχρι να τις διαγράψετε, ακόμη και μετά από επανεκκίνηση της συσκευής. Δεν υπάρχει λογαριασμός και η εφαρμογή δεν κάνει αιτήματα δικτύου. Μια σύνοψη φεύγει από τη συσκευή μόνο όταν την κοινοποιήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summaries are saved on this device only, encrypted, and kept until you delete them, even after the device restarts. There is no account, and the app makes no network requests. A summary leaves the device only when you share it."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Summaries are saved on this device only, encrypted, and kept until you delete them, even after the device restarts. There is no account, and the app makes no network requests. A summary leaves the device only when you share it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los resúmenes se guardan solo en este dispositivo, cifrados, y se conservan hasta que los elimines, incluso después de reiniciar el dispositivo. No hay cuenta y la app no hace ninguna solicitud de red. Un resumen solo sale del dispositivo cuando lo compartes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kokkuvõtted salvestatakse ainult sellesse seadmesse, krüpteerituna, ja neid hoitakse seni, kuni need kustutad, ka pärast seadme taaskäivitamist. Kontot ei ole ja rakendus ei tee võrgupäringuid. Kokkuvõte lahkub seadmest ainult siis, kui seda jagad."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laburpenak gailu honetan bakarrik gordetzen dira, enkriptatuta, eta ezabatzen dituzun arte mantentzen dira, gailua berrabiarazi ondoren ere. Ez dago konturik, eta aplikazioak ez du sare-eskaerarik egiten. Laburpen batek partekatzen duzunean bakarrik uzten du gailua."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خلاصه‌ها فقط روی همین دستگاه، به‌صورت رمزگذاری‌شده، ذخیره می‌شوند و تا وقتی آن‌ها را حذف نکنید باقی می‌مانند، حتی پس از راه‌اندازی مجدد دستگاه. حساب کاربری وجود ندارد و برنامه هیچ درخواست شبکه‌ای نمی‌فرستد. خلاصه فقط وقتی از دستگاه خارج می‌شود که خودتان آن را هم‌رسانی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yhteenvedot tallennetaan salattuina vain tälle laitteelle, ja ne säilyvät, kunnes poistat ne, myös laitteen uudelleenkäynnistyksen jälkeen. Tiliä ei ole, eikä sovellus tee verkkopyyntöjä. Yhteenveto lähtee laitteelta vain, jos jaat sen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
