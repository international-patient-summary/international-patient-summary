    "about.safety.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هذا التطبيق ليس جهازًا طبيًا. يعرض ما يقوله المستند ولا يغيّره أبدًا. القرارات السريرية من شأن الطبيب الذي يقرأ السجل الأصلي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Това приложение не е медицинско изделие. То показва какво пише в документа и никога не го променя. Клиничните решения са на лекаря, който чете изходния запис."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ई ऐप कवनो चिकित्सा उपकरण ना ह। ई उहे देखावेला जवन दस्तावेज़ में लिखल बा आ ओकरा के कबो ना बदले। इलाज के फैसला मूल रिकॉर्ड पढ़े वाला चिकित्सक के होला।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই অ্যাপটি কোনো চিকিৎসা যন্ত্র নয়। এটি নথিতে যা লেখা আছে তা-ই দেখায় এবং কখনো তা বদলায় না। ক্লিনিকাল সিদ্ধান্ত মূল রেকর্ড পড়া চিকিৎসকের।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tato aplikace není zdravotnický prostředek. Zobrazuje, co je v dokumentu, a nikdy ho nemění. Klinická rozhodnutí patří lékaři, který čte zdrojovou dokumentaci."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nid dyfais feddygol yw’r ap hwn. Mae’n dangos beth mae dogfen yn ei ddweud ac nid yw byth yn ei newid. Y clinigydd sy’n darllen y cofnod gwreiddiol sy’n gyfrifol am benderfyniadau clinigol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denne app er ikke medicinsk udstyr. Den viser, hvad et dokument siger, og ændrer det aldrig. Kliniske beslutninger træffes af den kliniker, der læser den oprindelige journal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese App ist kein Medizinprodukt. Sie zeigt, was in einem Dokument steht, und verändert es nie. Klinische Entscheidungen trifft die Ärztin oder der Arzt anhand der Originalakte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αυτή η εφαρμογή δεν είναι ιατροτεχνολογικό προϊόν. Δείχνει τι λέει ένα έγγραφο και δεν το αλλάζει ποτέ. Οι κλινικές αποφάσεις ανήκουν στον κλινικό που διαβάζει την αρχική εγγραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is not a medical device. It shows what a document says and never changes it. Clinical decisions belong to the clinician reading the source record."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This app is not a medical device. It shows what a document says and never changes it. Clinical decisions belong to the clinician reading the source record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta app no es un producto sanitario. Muestra lo que dice un documento y nunca lo modifica. Las decisiones clínicas corresponden al profesional que lee el registro de origen."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "See rakendus ei ole meditsiiniseade. See näitab, mida dokumendis on kirjas, ega muuda seda kunagi. Kliinilised otsused langetab algset terviseandmete kirjet lugev arst."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikazio hau ez da gailu medikoa. Dokumentu batek dioena erakusten du, eta ez du inoiz aldatzen. Erabaki klinikoak jatorrizko erregistroa irakurtzen duen osasun-profesionalari dagozkio."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این برنامه وسیلهٔ پزشکی نیست. آنچه را سند می‌گوید نشان می‌دهد و هرگز آن را تغییر نمی‌دهد. تصمیم‌های بالینی بر عهدهٔ پزشکی است که پروندهٔ اصلی را می‌خواند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
