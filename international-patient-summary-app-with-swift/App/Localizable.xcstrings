    },
    "about.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summaries are kept in this app's memory, on this device, and forgotten when the app closes. There is no account, and the app makes no network requests. A summary leaves the device only when you share it."
          }
        }
      }
    },
    "about.privacy.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "about.safety.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not a medical device. It shows what a document says and never changes it. Clinical decisions belong to the clinician reading the source record."
          }
        }
      }
    },
    "about.safety.heading": {
      "extractionState": "manual",
