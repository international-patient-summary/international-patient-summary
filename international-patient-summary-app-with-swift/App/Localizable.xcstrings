    "about.clearAll.confirm.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تُحذف كل الملخصات من هذا الجهاز. لا يمكن التراجع عن ذلك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Всички резюмета се изтриват от това устройство. Това не може да бъде отменено."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सगरी सारांश एह डिवाइस से हटा दिहल जाई। एकरा के वापस ना कइल जा सकेला।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই ডিভাইস থেকে সব সারসংক্ষেপ মুছে ফেলা হবে। এটি আর ফেরানো যাবে না।"
          }
