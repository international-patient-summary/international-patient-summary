        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הסיכומים נשמרים במכשיר הזה בלבד, מוצפנים, ונשארים בו עד שמוחקים אותם, גם אחרי שהמכשיר מופעל מחדש. אין חשבון, והאפליקציה לא שולחת בקשות רשת. סיכום יוצא מהמכשיר רק כשמשתפים אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सारांश केवल इस डिवाइस पर, एन्क्रिप्ट करके सहेजे जाते हैं और तब तक रखे जाते हैं जब तक आप उन्हें हटा नहीं देते, डिवाइस रीस्टार्ट होने के बाद भी। कोई खाता नहीं है, और ऐप कोई नेटवर्क अनुरोध नहीं करता। सारांश डिवाइस से तभी बाहर जाता है जब आप उसे शेयर करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sažeci se spremaju samo na ovaj uređaj, šifrirani, i čuvaju se dok ih ne izbrišete, čak i nakon ponovnog pokretanja uređaja. Nema korisničkog računa, a aplikacija ne šalje nikakve mrežne zahtjeve. Sažetak napušta uređaj samo kad ga podijelite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az összefoglalók csak ezen az eszközön, titkosítva tárolódnak, és addig maradnak meg, amíg Ön nem törli őket, az eszköz újraindítása után is. Nincs fiók, és az alkalmazás nem küld hálózati kérést. Egy összefoglaló csak akkor hagyja el az eszközt, ha Ön megosztja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ringkasan hanya disimpan di perangkat ini, terenkripsi, dan tetap ada sampai Anda menghapusnya, bahkan setelah perangkat dimulai ulang. Tidak ada akun, dan aplikasi tidak membuat permintaan jaringan. Ringkasan hanya keluar dari perangkat saat Anda membagikannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yfirlit eru aðeins vistuð á þessu tæki, dulkóðuð, og geymd þar til þú eyðir þeim, líka eftir að tækið er endurræst. Enginn aðgangur er til staðar og forritið sendir engar netbeiðnir. Yfirlit fer aðeins af tækinu þegar þú deilir því."
