    "share.confirm.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ملخصات أكثر من شخص واحد مفتوحة. تحقّق من أن هذا هو الشخص الذي تقصد مشاركة ملخصه."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отворени са резюмета на повече от един човек. Проверете дали това е човекът, чието резюме искате да споделите."
          }
        },
        "bho" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक से अधिका व्यक्ति के सारांश खुलल बा। जाँच लीं कि ई उहे व्यक्ति बा जेकर सारांश रउआ शेयर करे के चाहत बानी।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একাধিক ব্যক্তির সারসংক্ষেপ খোলা আছে। নিশ্চিত হয়ে নিন যে এটিই সেই ব্যক্তি যাঁর সারসংক্ষেপ আপনি শেয়ার করতে চান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jsou otevřené souhrny více než jedné osoby. Zkontrolujte, že jde o osobu, jejíž souhrn chcete sdílet."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae crynodebau mwy nag un person ar agor. Gwiriwch mai hwn yw’r person rydych chi’n bwriadu ei rannu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oversigter for mere end én person er åbne. Kontrollér, at det er den person, du vil dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Übersichten mehrerer Personen sind geöffnet. Prüfen Sie, ob dies die Person ist, deren Übersicht Sie teilen möchten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Είναι ανοιχτές συνόψεις για περισσότερα από ένα άτομα. Ελέγξτε ότι αυτό είναι το άτομο του οποίου τη σύνοψη θέλετε να κοινοποιήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summaries of more than one person are open. Check that this is the person you mean to share."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Summaries of more than one person are open. Check that this is the person you mean to share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hay resúmenes abiertos de más de una persona. Comprueba que esta es la persona cuyo resumen quieres compartir."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Avatud on rohkem kui ühe inimese kokkuvõtted. Kontrolli, et see on inimene, kelle kokkuvõtet soovid jagada."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pertsona batek baino gehiagoren laburpenak daude irekita. Egiaztatu hau dela partekatu nahi duzun pertsona."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خلاصه‌های بیش از یک نفر باز است. بررسی کنید که این همان فردی است که می‌خواهید خلاصه‌اش را هم‌رسانی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Useamman kuin yhden henkilön yhteenvedot ovat auki. Tarkista, että tämä on henkilö, jonka yhteenvedon haluat jakaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bukas ang mga buod ng higit sa isang tao. Tiyaking ito ang taong gusto mong ibahagi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Des résumés de plusieurs personnes sont ouverts. Vérifiez qu’il s’agit bien de la personne dont vous voulez partager le résumé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tá achoimrí ar níos mó ná duine amháin oscailte. Seiceáil gurb é seo an duine ar mian leat a achoimre a chomhroinnt."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tha geàrr-chunntasan air barrachd air aon duine fosgailte. Dèan cinnteach gur e seo an duine a tha thu airson a cho-roinneadh."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "એક કરતાં વધુ વ્યક્તિના સારાંશ ખુલ્લા છે. ખાતરી કરો કે તમે જે વ્યક્તિનો સારાંશ શેર કરવા માગો છો તે આ જ છે."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taƙaitattun bayanan mutane fiye da ɗaya suna buɗe. Ku tabbatar cewa wannan shi ne mutumin da kuke son turawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פתוחים סיכומים של יותר מאדם אחד. כדאי לוודא שזה האדם שרוצים לשתף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक से अधिक व्यक्तियों के सारांश खुले हैं। जाँच लें कि आप इसी व्यक्ति का सारांश शेयर करना चाहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otvoreni su sažeci više osoba. Provjerite je li to osoba čiji sažetak želite podijeliti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Több személy összefoglalója van megnyitva. Ellenőrizze, hogy valóban ennek a személynek az összefoglalóját kívánja-e megosztani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ringkasan lebih dari satu orang sedang terbuka. Pastikan ini orang yang ingin Anda bagikan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yfirlit fleiri en eins einstaklings eru opin. Gakktu úr skugga um að þetta sé einstaklingurinn sem þú ætlar að deila."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sono aperti i riepiloghi di più persone. Verifica che sia la persona che vuoi condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "複数の人のサマリーが開いています。共有したい人で間違いないか確認してください。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ringkesan luwih saka siji wong lagi kabukak. Priksa manawa iki wong sing arep panjenengan bagèkaké."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "សេចក្ដីសង្ខេបរបស់មនុស្សច្រើនជាងម្នាក់កំពុងបើក។ សូមពិនិត្យថា នេះជាបុគ្គលដែលអ្នកចង់ចែករំលែក។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಒಬ್ಬರಿಗಿಂತ ಹೆಚ್ಚು ವ್ಯಕ್ತಿಗಳ ಸಾರಾಂಶಗಳು ತೆರೆದಿವೆ. ನೀವು ಹಂಚಿಕೊಳ್ಳಲು ಬಯಸುವ ವ್ಯಕ್ತಿ ಇವರೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "여러 사람의 요약이 열려 있습니다. 공유하려는 사람이 맞는지 확인하세요."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iwwersiichte vu méi wéi enger Persoun sinn op. Kuckt no, ob dat d’Persoun ass, där hir Iwwersiicht Dir deele wëllt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ມີບົດສະຫຼຸບຂອງຫຼາຍກວ່າໜຶ່ງຄົນເປີດຢູ່. ກະລຸນາກວດເບິ່ງວ່ານີ້ແມ່ນບຸກຄົນທີ່ທ່ານຕ້ອງການແບ່ງປັນບົດສະຫຼຸບ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
