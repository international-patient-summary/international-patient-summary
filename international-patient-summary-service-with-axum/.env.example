# Copy to .env for local development; .env is never committed.
APP_ENV=development
DB_URL=postgres://ips:ips@127.0.0.1:5432/international_patient_summary_service_development
# The Svelte UI's dev server, so the browser may read answers from this service.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# For `cargo test -- --include-ignored`: a role that may create databases.
AXA_TEST_DB_URL=postgres://ips:ips@127.0.0.1:5432/postgres
