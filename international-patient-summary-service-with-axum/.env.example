# Copy to .env for local development; .env is never committed.
APP_ENV=development
DB_URL=postgres://ips:ips@127.0.0.1:5432/international_patient_summary_service_development
# The Svelte UI's dev server, so the browser may read answers from this service.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# For `cargo test -- --include-ignored`: a role that may create databases.
AXA_TEST_DB_URL=postgres://ips:ips@127.0.0.1:5432/postgres
# Authentication (spec §6.1). With neither set, every /fhir route is open, which
# only development and test allow. Keycloak: `podman compose --profile keycloak up -d`.
# IPS_KEYCLOAK_URL=http://localhost:8080
# IPS_KEYCLOAK_REALM=ips
# IPS_KEYCLOAK_AUDIENCES=ips-service
# PASETO: the issuer's published Ed25519 key set, and its issuer and audience.
# IPS_PASETO_KEYS_FILE=/path/to/keys.json
# IPS_PASETO_ISSUER=authentication-service
# IPS_PASETO_AUDIENCE=ips-service
