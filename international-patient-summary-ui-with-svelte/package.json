{
	"name": "international-patient-summary-ui-with-svelte",
	"version": "0.1.0",
	"description": "A client-side viewer for HL7 FHIR International Patient Summary (IPS) documents, built with Svelte 5, SvelteKit 3 and the Lily Design System.",
	"type": "module",
	"private": true,
	"license": "MIT OR Apache-2.0 OR GPL-2.0-only OR GPL-3.0-only OR BSD-3-Clause",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"predev": "node bin/vendor-lily.mjs",
		"dev": "vite dev",
		"prebuild": "node bin/vendor-lily.mjs",
		"sync:lily": "node bin/vendor-lily.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lilydesignsystem/svelte-headless": "0.9.0",
		"@lilydesignsystem/svelte-picker-bar": "0.6.0",
		"@sveltia/i18n": "1.5.0",
		"dompurify": "3.4.18",
		"pdfmake": "0.3.14",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@lilydesignsystem/themes": "0.6.2",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.10",
		"@types/fhir": "0.0.44",
		"@types/node": "^26.0.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "31.0.1",
		"messageformat": "4.1.0",
		"pdfjs-dist": "6.5.438",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.50.0",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
